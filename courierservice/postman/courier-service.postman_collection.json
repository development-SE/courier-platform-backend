{
  "info": {
    "_postman_id": "6f3f8c8d-2f53-4f44-b0d7-4d2f5d90d2b1",
    "name": "courier-service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Contractor Courier",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{adminUserId}}"
          },
          {
            "key": "X-User-Roles",
            "value": "{{adminRoles}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{contractorUserId}}\",\n  \"companyId\": null,\n  \"courierType\": \"CONTRACTOR\",\n  \"employmentStatus\": \"ACTIVE\",\n  \"transportType\": \"BIKE\",\n  \"isVerified\": true,\n  \"canTakeOrders\": true,\n  \"maxActiveOrders\": 1,\n  \"notes\": \"Independent courier\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/couriers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "couriers"
          ]
        }
      }
    },
    {
      "name": "Create Employee Courier",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{adminUserId}}"
          },
          {
            "key": "X-User-Roles",
            "value": "{{adminRoles}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{employeeUserId}}\",\n  \"companyId\": \"{{companyId}}\",\n  \"courierType\": \"EMPLOYEE\",\n  \"employmentStatus\": \"ACTIVE\",\n  \"transportType\": \"CAR\",\n  \"isVerified\": true,\n  \"canTakeOrders\": true,\n  \"maxActiveOrders\": 2,\n  \"notes\": \"Scheduled employee courier\",\n  \"schedules\": [\n    {\n      \"weekday\": \"MONDAY\",\n      \"startTime\": \"09:00:00\",\n      \"endTime\": \"18:00:00\",\n      \"timezone\": \"Asia/Qyzylorda\",\n      \"active\": true\n    },\n    {\n      \"weekday\": \"TUESDAY\",\n      \"startTime\": \"09:00:00\",\n      \"endTime\": \"18:00:00\",\n      \"timezone\": \"Asia/Qyzylorda\",\n      \"active\": true\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/couriers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "couriers"
          ]
        }
      }
    },
    {
      "name": "Get Courier",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{adminUserId}}"
          },
          {
            "key": "X-User-Roles",
            "value": "{{adminRoles}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/couriers/{{courierId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "couriers",
            "{{courierId}}"
          ]
        }
      }
    },
    {
      "name": "Update Courier",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{adminUserId}}"
          },
          {
            "key": "X-User-Roles",
            "value": "{{adminRoles}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employmentStatus\": \"ACTIVE\",\n  \"isVerified\": true,\n  \"canTakeOrders\": true,\n  \"maxActiveOrders\": 3,\n  \"notes\": \"Updated from Postman\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/couriers/{{courierId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "couriers",
            "{{courierId}}"
          ]
        }
      }
    },
    {
      "name": "Get Eligibility Now",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{adminUserId}}"
          },
          {
            "key": "X-User-Roles",
            "value": "{{managerRoles}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/couriers/{{courierId}}/eligibility",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "couriers",
            "{{courierId}}",
            "eligibility"
          ]
        }
      }
    },
    {
      "name": "Get Eligibility At Specific Time",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{adminUserId}}"
          },
          {
            "key": "X-User-Roles",
            "value": "{{managerRoles}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/couriers/{{courierId}}/eligibility?at={{eligibilityAtEncoded}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "couriers",
            "{{courierId}}",
            "eligibility"
          ],
          "query": [
            {
              "key": "at",
              "value": "{{eligibilityAtEncoded}}"
            }
          ]
        }
      }
    },
    {
      "name": "Negative Test - Employee Without Schedule",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{adminUserId}}"
          },
          {
            "key": "X-User-Roles",
            "value": "{{adminRoles}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{negativeUserId}}\",\n  \"companyId\": \"{{companyId}}\",\n  \"courierType\": \"EMPLOYEE\",\n  \"employmentStatus\": \"ACTIVE\",\n  \"transportType\": \"CAR\",\n  \"isVerified\": true,\n  \"canTakeOrders\": true,\n  \"maxActiveOrders\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/couriers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "couriers"
          ]
        }
      }
    }
  ],
