							"raw": "{\n  \"serviceType\": \"STANDARD\",\n  \"comment\": \"Test OSRM routing\",\n  \"parcelSize\": \"SMALL\",\n  \"items\": [\n    {\n      \"itemId\": \"ITEM-1\",\n      \"name\": \"Package\",\n      \"quantity\": 1,\n      \"price\": 100.0\n    }\n  ],\n  \"pickupAddress\": {\n    \"type\": \"COMPANY\",\n    \"city\": \"Almaty\",\n    \"street\": \"Auezov Metro\",\n    \"house\": \"1\",\n    \"latitude\": 43.24350,\n    \"longitude\": 76.90450\n  },\n  \"pickupInfo\": {\n    \"name\": \"Warehouse\",\n    \"phone\": \"+77777777777\"\n  },\n  \"deliveryAddress\": {\n    \"type\": \"USER\",\n    \"city\": \"Almaty\",\n    \"street\": \"Al-Farabi\",\n    \"house\": \"2\",\n    \"latitude\": 43.22050,\n    \"longitude\": 76.91500\n  },\n  \"recipientInfo\": {\n    \"name\": \"John\",\n    \"phone\": \"+77777777777\"\n  }\n}"
						},
